# Copy to .env (never commit .env). Used by the Python agent service.
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=kelma

# Free-tier LLM (CrewAI uses LiteLLM names: provider/model). Check the provider's current free models.
LLM_MODEL=gemini/<model-name>
LLM_API_KEY=

# Langfuse (optional tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
